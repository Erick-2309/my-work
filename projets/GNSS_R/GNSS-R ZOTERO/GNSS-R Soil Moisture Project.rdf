&lt;tr&gt;
&lt;td&gt;
&lt;p&gt;GLONASS L2&lt;/p&gt;
&lt;/td&gt;
&lt;td&gt;
&lt;p&gt;1246.00&lt;/p&gt;
&lt;/td&gt;
&lt;td&gt;
&lt;p&gt;0.2406&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td&gt;
&lt;p&gt;BeiDou B1I&lt;/p&gt;
&lt;/td&gt;
&lt;td&gt;
&lt;p&gt;1561.098&lt;/p&gt;
&lt;/td&gt;
&lt;td&gt;
&lt;p&gt;0.1920&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td&gt;
&lt;p&gt;BeiDou B2a&lt;/p&gt;
&lt;/td&gt;
&lt;td&gt;
