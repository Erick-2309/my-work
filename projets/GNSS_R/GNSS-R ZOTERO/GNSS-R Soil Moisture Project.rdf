&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td&gt;
&lt;p&gt;Galileo E5b&lt;/p&gt;
&lt;/td&gt;
&lt;td&gt;
&lt;p&gt;1207.14&lt;/p&gt;
&lt;/td&gt;
&lt;td&gt;
&lt;p&gt;0.2483&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td&gt;
&lt;p&gt;GLONASS L1&lt;/p&gt;
&lt;/td&gt;
&lt;td&gt;
&lt;p&gt;1602.00&lt;/p&gt;
&lt;/td&gt;
&lt;td&gt;
