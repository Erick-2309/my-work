&lt;tr&gt;
&lt;td&gt;
&lt;p&gt;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;Sous-total&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;td&gt;
&lt;p&gt;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;2,79 W&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
