&lt;/td&gt;
&lt;/tr&gt;
&lt;/tbody&gt;
&lt;/table&gt;
&lt;hr&gt;
&lt;h2&gt;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;Cas 1 : Sans Wi-Fi&lt;/span&gt;&lt;/h2&gt;
&lt;table&gt;
&lt;tbody&gt;
&lt;tr&gt;
&lt;th&gt;
&lt;p&gt;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;Équipement&lt;/span&gt;&lt;/p&gt;
&lt;/th&gt;
&lt;th&gt;
