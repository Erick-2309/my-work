&lt;/th&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td&gt;
&lt;p&gt;Galileo E1&lt;/p&gt;
&lt;/td&gt;
&lt;td&gt;
&lt;p&gt;1575.42&lt;/p&gt;
&lt;/td&gt;
&lt;td&gt;
