&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td&gt;
&lt;p&gt;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;2 antennes actives&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
