&lt;p&gt;31&lt;/p&gt;
&lt;/td&gt;
&lt;td&gt;
&lt;p&gt;L1 (1575,42 MHz), L2 (1227,60 MHz) et L5 (1176,45 MHz)&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td&gt;
&lt;p&gt;&lt;strong&gt;GLONASS&lt;/strong&gt;&lt;/p&gt;
&lt;/td&gt;
