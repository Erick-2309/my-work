    <z:Collection rdf:about="#collection_9">
        <dc:title>drone achitecture</dc:title>
        <dcterms:hasPart rdf:resource="#item_56"/>
        <dcterms:hasPart rdf:resource="#item_61"/>
        <dcterms:hasPart rdf:resource="#item_62"/>
        <dcterms:hasPart rdf:resource="#item_63"/>
        <dcterms:hasPart rdf:resource="#item_65"/>
        <dcterms:hasPart rdf:resource="#item_66"/>
        <dcterms:hasPart rdf:resource="#item_67"/>
